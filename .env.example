# Public application URL (for example, http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E2E fixtures refuse non-local Supabase URLs unless the project ref is listed (comma-separated).
E2E_TEST_SUPABASE_REFS=

# Server only
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=

# Scripts only (scripts/sql.sh runs migrations through the Supabase Management API)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# UI feature flag; enable only after own-question marking is calibrated
ENABLE_OWN_QUESTION_MARKING=false
